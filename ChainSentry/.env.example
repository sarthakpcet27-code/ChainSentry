# ==============================================================================
# ChainSentry Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME=ChainSentry
DEBUG=true

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security & API Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key
API_KEY=

# LLM & AI Analysis Integrations (explanations only; never a vuln database)
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Vulnerability & Threat Intelligence Data Feeds
GITHUB_TOKEN=
NVD_API_KEY=
OSV_API_URL=https://api.osv.dev/v1

# Database & Persistence
DATABASE_URL=sqlite:///./chainsentry.db
REDIS_URL=redis://localhost:6379/0

# Firebase Admin SDK Configuration (Firestore)
# Provide either a path to serviceAccountKey.json or raw JSON string
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=chainsentry-dev
